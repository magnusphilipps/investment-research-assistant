# ============================================================
# .gitignore — Investment Research Assistant
# ============================================================
# Files and folders listed here are NOT tracked by Git.
# This keeps the repository clean and prevents secrets,
# build artefacts, and machine-specific files from being shared.

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

# Byte-compiled / optimised source files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
wheels/
sdist/
*.whl

# Virtual environments (local dependency installs)
.venv/
venv/
env/
ENV/
.env

# pip / uv artefacts
pip-log.txt
pip-delete-this-directory.txt
uv.lock

# Test and coverage reports
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# mypy / pyright type checking cache
.mypy_cache/
.pyright/
pyrightconfig.json

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# ------------------------------------------------------------
# Replit
# ------------------------------------------------------------

# Replit stores installed Python packages here — not needed in Git
.pythonlibs/

# Replit internal config — machine-specific, do not commit
.replit
.replitignore
.upm/

# Replit breakpoints / debug state
.breakpoints

# ------------------------------------------------------------
# Environment variables and secrets
# ------------------------------------------------------------
# Never commit API keys, passwords, or tokens.

.env
.env.*
*.env
secrets.toml
config.local.*

# ------------------------------------------------------------
# Editor and OS files
# ------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs (PyCharm, etc.)
.idea/

# Vim swap files
*.swp
*.swo
*~

# ------------------------------------------------------------
# Logs and temporary files
# ------------------------------------------------------------
*.log
*.tmp
*.bak
